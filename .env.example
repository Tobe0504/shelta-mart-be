NODE_ENV=development
PORT=4000
# Where the Next.js app runs; used for CORS and payment callbacks.
CLIENT_URL=http://localhost:3001

MONGODB_URI=mongodb://127.0.0.1:27017/sheltamart

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# lax works when the frontend proxies /api to this server (same site). Use none for a different domain (needs HTTPS).
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Paystack. Leave empty to use the built-in dev payment simulator.
PAYSTACK_SECRET_KEY=

# Cloudinary. Uploads return 503 until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
